---
// Сравнение только по категориям, без названий компаний. Одни данные — два вида:
// таблица на ≥ md, три карточки со всеми строками на мобильном.
const cols = [
  { title: 'Водитель', ours: false },
  { title: 'Импортный робот (AGV/AMR)', ours: false },
  { title: 'Беспилотный погрузчик', ours: true },
];
// null — пункт неприменим (у водителя нет поставок и господдержки)
const rows: { label: string; values: [string | null, string, string] }[] = [
  { label: 'Стоимость', values: ['от 200 тыс. ₽/\u2060мес на машину при 2 сменах', '4–\u206014 млн ₽ за машину', '2,5 млн ₽ под ключ или 160 тыс. ₽/\u2060мес'] },
  { label: 'Работа 24/7', values: ['4 водителя на пост, больничные, текучка', 'да', 'да'] },
  { label: 'Навигация', values: ['человек', 'лидар', 'камеры + потолочные метки, без лидара'] },
  { label: 'Внедрение', values: ['найм и обучение', 'часто нужна новая разметка или остановка зоны', 'без остановки склада и без новой разметки'] },
  { label: 'Поставки и сервис', values: [null, 'зависимость от вендора, сложные поставки, уход с рынка', 'сделано в России, свой сервис на весь срок службы'] },
  { label: 'Господдержка', values: [null, 'нет', 'можно получить софинансирование'] },
];
---
<section id="compare" class="border-t border-line py-20 md:py-28" aria-labelledby="compare-title">
  <div class="container-x">
    <p class="tag">// Сравнение</p>
    <h2 id="compare-title" class="cmp-title mt-4 max-w-[900px] font-bold text-balance md:mt-5">Почему не&nbsp;водитель и&nbsp;не&nbsp;импортный робот</h2>

    <ul class="mt-10 grid gap-5 md:hidden">
      {cols.map((c, ci) => (
        <li class:list={['border', c.ours ? 'ours border-acc/40 bg-acc/10' : 'border-line bg-bg2']}>
          <h3 class="px-4 pt-5 pb-4 text-[15px] font-bold">{c.title}</h3>
          <dl>
            {rows.map((r) => (
              <div class="border-t border-line px-4 py-3">
                <dt class="font-mono text-[10px] tracking-[.06em] text-mut uppercase">{r.label}</dt>
                <dd class="mt-1 text-[15px] leading-snug">
                  {r.values[ci] ?? <><span aria-hidden="true" class="text-mut">—</span><span class="sr-only">не применимо</span></>}
                </dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>

    <table class="mt-14 hidden w-full table-fixed border-collapse text-left md:table">
      <caption class="sr-only">Водитель, импортный робот и беспилотный погрузчик по шести критериям</caption>
      <colgroup><col class="w-[22%] lg:w-[19%]" /><col /><col /><col /></colgroup>
      <thead>
        <tr>
          <td></td>
          {cols.map((c) => (
            <th scope="col" class:list={['px-4 pt-6 pb-4 align-bottom font-display text-[14px] leading-tight font-bold tracking-[-0.01em] uppercase lg:px-5 lg:text-[15px]', c.ours && 'ours bg-acc/10']}>{c.title}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-t border-line">
            <th scope="row" class="py-4 pr-4 align-top font-mono text-[11px] leading-5 font-normal tracking-[.06em] text-mut uppercase">{r.label}</th>
            {r.values.map((v, ci) => (
              <td class:list={['px-4 py-4 align-top text-[15px] leading-snug lg:px-5', cols[ci].ours && 'bg-acc/10 font-medium']}>
                {v ?? <><span aria-hidden="true" class="text-mut">—</span><span class="sr-only">не применимо</span></>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
<style>
  .cmp-title { font-size: clamp(22px, calc((100vw - 32px) / 15), 44px); }
  /* Жёлтая верхняя полоса колонки/карточки «Беспилотный погрузчик» */
  .ours { box-shadow: inset 0 4px 0 var(--color-acc); }
</style>
