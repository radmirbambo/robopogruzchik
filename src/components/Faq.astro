---
// Аккордеон на <details>: работает без JS и с клавиатуры (Enter/Space на summary).
// Тексты — data/faq.ts, из того же массива строится FAQPage в JSON-LD.
import { FAQ } from '../data/faq';

// Число не отрывается от единицы («12 м»), предлоги и союзы из 1–2 букв не остаются в конце строки
// (единицы после числа предлогами не считаем). Только в разметке: JSON-LD получает исходный текст.
const nb = (s: string) => s
  .replace(/(\d) (?=[а-яё])/giu, '$1\u00A0')
  .replace(/(?<=^|[ \u00A0])(?<!\d\u00A0)([а-яё]{1,2}) /giu, '$1\u00A0');
---
<section id="faq" class="border-t border-line py-20 md:py-28" aria-labelledby="faq-title">
  <div class="faq-grid container-x">
    <div class="faq-head">
      <p class="tag">// Вопросы</p>
      <h2 id="faq-title" class="faq-title mt-4 font-bold md:mt-5">Частые вопросы</h2>
    </div>
    <div class="border-b border-line">
      {FAQ.map((f) => (
        <details class="faq border-t border-line">
          <summary class="flex cursor-pointer items-start justify-between gap-5 py-5 pr-1 pl-4 md:py-6 md:pl-5">
            <span class="text-base leading-snug font-medium md:text-lg">{nb(f.q)}</span>
            <span class="plus font-mono text-[22px] leading-[22px] text-mut" aria-hidden="true">+</span>
          </summary>
          <p class="max-w-[640px] pr-10 pb-6 pl-4 text-[15px] leading-relaxed text-pretty text-mut md:pb-7 md:pl-5 md:text-base">{nb(f.a)}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-title { font-size: clamp(26px, calc((100vw - 32px) / 12), 44px); }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 40px; }
  @media (width >= 1024px) {
    .faq-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: 56px; align-items: start; }
    .faq-head { position: sticky; top: 6rem; }
  }

  /* Открытый вопрос — жёлтая граница слева, плюс поворачивается в крестик */
  .faq { border-left: 2px solid transparent; transition: border-color .2s; }
  .faq[open] { border-left-color: var(--color-acc); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover .plus, .faq[open] .plus { color: var(--color-fg); }
  .plus { flex-shrink: 0; transition: transform .2s, color .2s; }
  .faq[open] .plus { transform: rotate(45deg); }
</style>
