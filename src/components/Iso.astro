---
// Изометрический line-art 200×160 для шагов «Как это работает».
// Тележка — геометрия из мокапа C «Чертёж», ужатая под 200×160: корпус-ромб, стойки, вилы, рукоять.
// Жёлтым — только то, что добавляем мы: камера, лучи к меткам, задача из WMS.
interface Props { kind: 'truck' | 'pak' | 'markers' | 'wms'; class?: string }
const { kind, class: cls = '' } = Astro.props;

const FG = '#F2F0EA';
const ACC = '#FFC629';
const MUT = '#8C9098';
// Заливка экранов = фон панели шага (bg2): задние экраны стопки прячутся за передним
const PANEL = '#1C1F23';

const TRUCK = [
  'M40 80 l60 -30 l60 30 l-60 30z', // корпус
  'M40 80 v34 l60 30 v-34', // стойки и передняя грань
  'M160 80 v34 l-60 30',
  'M40 114 l-32 16 l8 4 l32 -16', // вилы
  'M64 126 l-32 16 l8 4 l32 -16',
  'M118 71 l16 -38 M127 29.5 l14 7', // рукоять: ручное управление остаётся
];
// ПАК: стойка камеры на корпусе и сам блок камеры
const MAST = 'M82 84 v-34';
const CAM = 'M74 38 l8 -4 l8 4 v8 l-8 4 l-8 -4z';
const CAM_EDGES = 'M74 38 l8 4 l8 -4 M82 42 v8';
const diamond = (cx: number, cy: number, w = 7) => `M${cx - w} ${cy} l${w} ${-w / 2} l${w} ${w / 2} l${-w} ${w / 2}z`;

// Потолок: сетка 3×3 меток вокруг центра (100; 46), шаги по осям a = (24; 12) и b = (24; −12)
const grid = [-1, 0, 1].flatMap((i) => [-1, 0, 1].map((j) => ({ x: 100 + 24 * i + 24 * j, y: 46 + 12 * i - 12 * j })));
// Линии сетки через метки: вдоль a (от метки i = −1) и вдоль b (от метки j = −1)
const LATTICE = [-1, 0, 1].map((k) => `M${76 + 24 * k} ${34 - 12 * k} l48 24 M${76 + 24 * k} ${58 + 12 * k} l48 -24`).join(' ');
const rays = grid.filter((m) => m.y >= 58); // передний ряд: от этих меток лучи вниз
const DROP = 70; // высота потолка на рисунке

// WMS: три стопки экранов (задний, средний, передний), в третьей жёлтая строка — задача роботу
const screen = (x: number, y: number) => `M${x} ${y} l36 18 v26 l-36 -18z`;
const rows = (x: number, y: number) => [`M${x + 5} ${y + 8.5} l18 9`, `M${x + 5} ${y + 14.5} l24 12`, `M${x + 5} ${y + 20.5} l12 6`];
const stacks = [10, 70, 130].map((x, s) => ({ x, y: 22, hot: s === 2 }));
---
<svg class:list={['iso', cls]} viewBox="0 0 200 160" fill="none" stroke-linejoin="round" stroke-linecap="round"
  aria-hidden="true" focusable="false">
  {(kind === 'truck' || kind === 'pak') && (
    <g stroke={FG} stroke-width="1.4">{TRUCK.map((d) => <path d={d} />)}</g>
  )}

  {kind === 'pak' && (
    <>
      <g stroke={ACC} stroke-dasharray="3 4" opacity=".8"><path d="M82 34 L34 17 M82 34 L156 17" /></g>
      <g fill={FG}><path d={diamond(34, 12, 10)} /><path d={diamond(156, 12, 10)} /></g>
      <path d={MAST} stroke={FG} stroke-width="1.4" />
      <path d={CAM} fill={ACC} /><path d={CAM_EDGES} stroke={PANEL} stroke-width="1" />
    </>
  )}

  {kind === 'markers' && (
    <>
      <path d="M16 46 l84 -42 l84 42 l-84 42z" stroke={MUT} opacity=".6" />
      <path d={LATTICE} stroke={MUT} opacity=".45" />
      <g stroke={ACC} stroke-dasharray="3 4" opacity=".8">{rays.map((m) => <path d={`M${m.x} ${m.y + 3.5} V${m.y + DROP - 3.5}`} />)}</g>
      <g stroke={ACC} stroke-width="1.4">{rays.map((m) => <path d={diamond(m.x, m.y + DROP)} />)}</g>
      <g fill={FG}>{grid.map((m) => <path d={diamond(m.x, m.y)} />)}</g>
      <path d={`M8 46 V${46 + DROP} M4 46 h8 M4 ${46 + DROP} h8`} stroke={MUT} />
    </>
  )}

  {kind === 'wms' && (
    <>
      <path d="M28 57 L100 80 M88 57 L100 80 M148 57 L100 80" stroke={MUT} stroke-dasharray="3 4" />
      {stacks.map(({ x, y, hot }) => (
        <g stroke-width="1.4">
          <path d={screen(x + 12, y - 6)} fill={PANEL} stroke={FG} opacity=".5" />
          <path d={screen(x + 6, y - 3)} fill={PANEL} stroke={FG} opacity=".75" />
          <path d={screen(x, y)} fill={PANEL} stroke={FG} />
          {rows(x, y).map((d, r) => <path d={d} stroke={hot && r === 0 ? ACC : MUT} />)}
        </g>
      ))}
      <path d="M100 80 V102 M95 96 l5 6 l5 -6" stroke={ACC} stroke-width="1.4" />
      {/* Робот = тележка с ПАК в масштабе 0,4; толщина обводки компенсирует масштаб */}
      <g transform="translate(66 92) scale(.4)">
        <g stroke={FG} stroke-width="3.5">{TRUCK.map((d) => <path d={d} />)}<path d={MAST} /></g>
        <path d={CAM} fill={ACC} />
      </g>
    </>
  )}

  <g font-family="JetBrains Mono, monospace" font-size="10" fill={MUT}>
    {kind === 'truck' && <text x="120" y="152">1,5–3 т</text>}
    {kind === 'pak' && (
      <>
        <text x="70" y="48" text-anchor="end">камера + ИИ</text>
        <text x="116" y="152">ПАК БП-01</text>
      </>
    )}
    {kind === 'markers' && (
      <>
        <text x="4" y="12">50×50 см</text>
        <text x="196" y="12" text-anchor="end">шаг 6 м</text>
        <text x="14" y="86">12 м</text>
      </>
    )}
    {kind === 'wms' && (
      <>
        <text x="10" y="10">WMS / ERP</text>
        <text x="108" y="94">RMS · ROS2</text>
      </>
    )}
  </g>
</svg>
<style>
  .iso { display: block; width: 100%; height: auto; }
</style>
